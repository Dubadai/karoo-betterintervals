<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb fake a remote button press for testing. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugRemoteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.daviddokakis.karoointerval.DEBUG_REMOTE" />
            </intent-filter>
        </receiver>
        <!-- Field gallery: the screen at Karoo sizes, light and dark (design-assets/tools/field-gallery) -->
        <activity
            android:name=".FieldGalleryActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Settings opened by adb on the emulator (am start), for checking the page; debug only -->
        <activity-alias
            android:name=".DebugSettings"
            android:exported="true"
            android:targetActivity=".SettingsActivity" />
        <!-- Indoor ERG spike: drive the trainer from adb (see DebugTrainerReceiver). -->
        <receiver
            android:name=".DebugTrainerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.daviddokakis.karoointerval.DEBUG_TRAINER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
