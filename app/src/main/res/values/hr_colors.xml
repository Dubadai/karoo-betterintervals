    <color name="karoo_hr_c4">#FFFB8C65</color>
    <color name="karoo_hr_c5">#FFFE581F</color>
    <color name="karoo_hr_c6">#FFD60404</color>
    <color name="karoo_hr_c7">#FFB700A2</color>
    <color name="karoo_hr_text">#FF000000</color>
