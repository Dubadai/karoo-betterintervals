<?xml version="1.0" encoding="utf-8"?>
<!-- START WORKOUT: green like the resume button, filling with the other green as the start countdown runs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/resume_bg" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/resume_bg_alt" /><corners android:radius="12dp" /></shape></clip>
    </item>
</layer-list>
