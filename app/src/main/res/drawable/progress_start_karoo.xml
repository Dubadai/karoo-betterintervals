<?xml version="1.0" encoding="utf-8"?>
<!-- START WORKOUT, Karoo style: Karoo yellow, filling with the darker yellow as the start countdown runs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/karoo_yellow" /><corners android:radius="12dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="@color/karoo_yellow_dark" /><corners android:radius="12dp" /></shape></clip>
    </item>
</layer-list>
