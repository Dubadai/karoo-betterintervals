<?xml version="1.0" encoding="utf-8"?>
<!--
  Range tint: fades in from the top edge (no hard line against Karoo's status bar), stays solid
  behind the watts, then fades out between the tiles and the Next box.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="40dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/range_bg_over"
                android:startColor="@color/range_bg_over_clear"
                android:type="linear" />
        </shape>
    </item>
    <item android:top="40dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="@color/range_bg_over"
                android:centerY="0.62"
                android:endColor="@color/range_bg_over_clear"
                android:startColor="@color/range_bg_over"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
