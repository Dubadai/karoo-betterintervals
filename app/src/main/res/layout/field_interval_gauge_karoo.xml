<?xml version="1.0" encoding="utf-8"?>
<!--
  Interval screen in the Gauge watts mode (5th option when you tap the watts): Target range in the
  top row, a power gauge with the watts inside, interval time and progress, then Lap avg / HR tiles.
  The other four watts modes use field_interval.xml. Sized for a Karoo 3 full page
  (about 255x385 dp); ScreenRenderer rescales text and the chart height for other field sizes.

  KAROO NATIVE STYLING variant (gauge screen): generated from field_interval_gauge.xml and kept in step
  with it. Karoo's condensed IBM Plex font, uppercase labels with green icons, Karoo-style cells
  on tonal tiles, Next up with its outline, Karoo-yellow skip and resume buttons.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Upper part: gauge, interval and progress, tiles. Its background is the optional
             target-range tint (third watts mode), which reaches the field's top and side edges and
             fades out halfway between the tiles and the Next box. -->
        <LinearLayout
            android:id="@+id/upper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

        <!-- Power gauge with the watts inside (one bitmap from GaugeRenderer). fitCenter keeps
             the arc and the number together when Karoo makes the field shorter (a loaded route).
             The top margin leaves room for the Target label and range in the top row. -->
        <ImageView
            android:id="@+id/gauge"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="34dp"
            android:layout_weight="1"
            android:contentDescription="@string/cd_gauge"
            android:scaleType="fitCenter" />

        <!-- Interval number + time left + progress. The label (or the paused box) and the time are
             siblings in one baseline-aligned row, so the bottoms of "INTERVAL 1 / 16" and "−2:18"
             line up exactly. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <!-- Timer icon on the label's capitals (14dp icon, baseline 12dp from its top) -->
            <ImageView
                android:id="@+id/icon_timer"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:baseline="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_timer"
                android:tint="@color/karoo_green" />

            <TextView
                android:id="@+id/interval_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="ibm-plex-sans-condensed"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <!-- While paused: a yellow box sized to its text (baseline = its text's), then a spacer -->
            <LinearLayout
                android:id="@+id/paused_box"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_paused"
                android:baselineAlignedChildIndex="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="4dp"
                android:paddingEnd="9dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/paused_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pause_filled" />

                <TextView
                    android:id="@+id/paused_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="ibm-plex-sans-condensed"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/paused_fg"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/paused_spacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <!-- Time left, counting down ("−2:18"), in Karoo's number font -->
            <TextView
                android:id="@+id/time_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:letterSpacing="-0.05"
                android:textColor="@color/text"
                android:textScaleX="0.9"
                android:textSize="27sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/interval_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="5dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_interval" />

        <!-- Lap avg and HR: cells the size of Karoo's own data fields (77dp ≈ 145 px tall, 6dp
             insets). Header: green icons left, 15sp label right, icons centred on the capitals via
             android:baseline (12dp icon, baseline 11dp from its top). Value: Karoo's number font
             (Plex Sans Regular, 90% wide, tighter), 48sp (the code shrinks a value that's too wide); its box starts 30dp
             up (under the header's empty space) and hangs 7dp below the cell (the font's empty
             descender space), so the digits sit 12 px above the cell's bottom, like Karoo's fields. -->
        <LinearLayout
            android:id="@+id/tiles_row"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/lap_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_tile_tonal"
                android:paddingHorizontal="6dp"
                android:paddingTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/icon_lap"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="3dp"
                        android:baseline="11dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lap"
                        android:tint="@color/karoo_green" />

                    <ImageView
                        android:id="@+id/icon_bolt"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="3dp"
                        android:baseline="11dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bolt_filled"
                        android:tint="@color/karoo_green" />

                    <TextView
                        android:id="@+id/lap_avg_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="ibm-plex-sans-condensed"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/lap_avg"
                        android:textAllCaps="true"
                        android:textColor="@color/text"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lap_avg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="-2dp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.05"
                    android:textScaleX="0.9"
                    android:gravity="end|bottom"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="48sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/hr_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:background="@drawable/bg_tile_tonal"
                android:paddingHorizontal="6dp"
                android:paddingTop="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/th_interval_gauge_karoo_3"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="3dp"
                        android:baseline="11dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_heart" />

                    <TextView
                        android:id="@+id/hr_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="ibm-plex-sans-condensed"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/hr"
                        android:textAllCaps="true"
                        android:textColor="@color/text"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="-2dp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.05"
                    android:textScaleX="0.9"
                    android:gravity="end|bottom"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="48sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- While choosing a jump: a small ✕ and "Confirm move" (right, above ⏭) in place of the tiles -->
        <LinearLayout
            android:id="@+id/confirm_row"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/btn_confirm_x"
                android:layout_width="48dp"
                android:layout_marginEnd="6dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_tile_tonal">

                <ImageView
                    android:id="@+id/th_interval_gauge_karoo_4"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_cancel_jump"
                    android:src="@drawable/ic_x"
                    android:tint="@color/text" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_confirm">

            <!-- Fills up while a remote-made choice confirms itself -->
            <ProgressBar
                android:id="@+id/confirm_fill"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                android:progressDrawable="@drawable/progress_confirm"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/th_interval_gauge_karoo_5"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check"
                    android:tint="@color/resume_fg" />

                <TextView
                    android:fontFamily="ibm-plex-sans-condensed"
                    android:id="@+id/confirm_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_move"
                    android:textColor="@color/resume_fg"
                    android:textSize="17sp"
                    android:textStyle="normal" />
            </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- "Move cancelled" after the ✕ next to Confirm move: same 52 dp, tap to hide -->
        <LinearLayout
            android:id="@+id/move_cancelled"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:background="@drawable/bg_info"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/th_interval_gauge_karoo_6"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                android:tint="@color/info_fg" />

            <TextView
                android:fontFamily="ibm-plex-sans-condensed"
                android:id="@+id/move_cancelled_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/move_cancelled"
                android:textColor="@color/info_fg"
                android:textSize="16sp"
                android:textStyle="normal" />
        </LinearLayout>

        </LinearLayout>

        <!-- Lower part: next interval / countdown and the chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="1dp">

        <!-- "Next up" box: ⏮ near the left edge, ⏭ near the right edge, each with an invisible tap
             area covering its end of the box; centred text. While a jump is being chosen, a fill
             grows behind everything (3 steps) and tapping the middle cancels. -->
        <FrameLayout
            android:id="@+id/next_box"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_outline">

            <ImageView
                android:id="@+id/select_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/bg_select_fill" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_previous"
                    android:layout_width="56dp"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:id="@+id/th_interval_gauge_karoo_7"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_btn_pause">

                        <ImageView
                            android:id="@+id/th_interval_gauge_karoo_8"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_previous"
                            android:src="@drawable/ic_previous" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/next_mid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:fontFamily="ibm-plex-sans-condensed"
                        android:id="@+id/next_label"
                        android:textAllCaps="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:fontFamily="ibm-plex-sans-condensed"
                        android:id="@+id/next_value"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:autoSizeMaxTextSize="20sp"
                        android:autoSizeMinTextSize="11sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/text"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btn_skip"
                    android:layout_width="56dp"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:id="@+id/skip_bg"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_btn_skip_karoo">

                        <ImageView
                            android:id="@+id/skip_icon"
                            android:tint="@color/karoo_yellow_fg"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_skip"
                            android:src="@drawable/ic_skip" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Jump countdown (replaces the next box) -->
        <LinearLayout
            android:id="@+id/countdown_box"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_countdown"
            android:gravity="center_vertical"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:visibility="gone">

            <TextView
                android:fontFamily="ibm-plex-sans-condensed"
                android:id="@+id/countdown"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/countdown_fg"
                android:textSize="31sp"
                android:textStyle="normal" />

            <TextView
                android:fontFamily="ibm-plex-sans-condensed"
                android:id="@+id/countdown_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/countdown_fg"
                android:textSize="20sp"
                android:textStyle="normal" />

            <!-- Invisible spacer as wide as the number, so the text is centred in the box -->
            <ImageView
                android:layout_width="28dp"
                android:layout_height="1dp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:contentDescription="@string/cd_chart"
            android:scaleType="fitXY" />
        </LinearLayout>

    </LinearLayout>

    <!-- Corner buttons on the outer layer, so they sit right in the corners. No background,
         48dp touch area each. -->
    <FrameLayout
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start">

        <ImageView
            android:id="@+id/th_interval_gauge_karoo_9"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_settings"
            android:alpha="0.55"
            android:tint="@color/text" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btn_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/btn_pause_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/cd_pause"
            android:src="@drawable/ic_pause" />
    </FrameLayout>

    <!-- Target, centred between the gear and pause: a small "Target" label with the range (or
         the target, when the step has no range) under it. During a jump, "→ 250" shows where it
         would land. -->
    <LinearLayout
        android:id="@+id/target_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:fontFamily="ibm-plex-sans-condensed"
            android:id="@+id/target_label"
            android:textAllCaps="true"
            android:drawableStart="@drawable/ic_target"
            android:drawablePadding="3dp"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/target"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:fontFamily="sans-serif"
                android:id="@+id/target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold"
                                android:textScaleX="0.9" />

            <TextView
                android:fontFamily="ibm-plex-sans-condensed"
                android:id="@+id/target_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:includeFontPadding="false"
                android:textColor="@color/land"
                android:textSize="14sp"
                android:textStyle="normal"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Resume button while you've paused the workout: a green half-pill, rounded on the left and
         flat against the screen edge. Replaces the small pause button. -->
    <FrameLayout
        android:id="@+id/btn_resume"
        android:layout_width="64dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_resume_karoo"
        android:visibility="gone">

        <ImageView
            android:id="@+id/th_interval_gauge_karoo_10"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:layout_marginStart="3dp"
            android:contentDescription="@string/cd_resume"
            android:src="@drawable/ic_play_filled"
            android:tint="@color/karoo_yellow_fg" />
    </FrameLayout>
</FrameLayout>
