<?xml version="1.0" encoding="utf-8"?>
<!--
  GENERATED by tools/gen_ready_layouts.py from field_interval_karoo.xml. Do not edit by hand.
  Full-page interval screen, rendered as RemoteViews (only framework layouts/widgets allowed).
  Sized for a Karoo 3 full page (about 255x385 dp). ScreenRenderer rescales text and the chart
  height for other field sizes.

  KAROO NATIVE STYLING variant (classic screen): generated from field_interval.xml and kept in step
  with it. Karoo's condensed IBM Plex font, uppercase labels with green icons, Karoo-style cells
  on tonal tiles, Next up with its outline, Karoo-yellow skip and resume buttons.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Upper part (ready): live watts, START WORKOUT in the middle, the workout's name and
             total time. Generated by tools/gen_ready_layouts.py. -->
        <LinearLayout
            android:id="@+id/upper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

        <!-- Watts (live, while you ride before starting), smaller than on the workout screen -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:fontFamily="relative"
                android:letterSpacing="-0.04"
                android:id="@+id/watts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="80sp"
                android:autoSizeMinTextSize="28sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingTop="26dp"
                android:textColor="@color/text"
                android:textStyle="normal" />

            <!-- The Karoo's empty state ("No Sensor", "Searching…") where the number goes -->
            <ImageView
                android:id="@+id/watts_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- START WORKOUT: ▶ above the words, the whole box is the button. During the start
             countdown: the seconds above TAP TO CANCEL, and the button fills with its darker
             colour as they run down. -->
        <FrameLayout
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:contentDescription="@string/start_workout">

            <ProgressBar
                android:id="@+id/start_fill"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                android:progressDrawable="@drawable/progress_start_karoo" />

            <LinearLayout
                android:id="@+id/start_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/start_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_play_filled"
                    android:tint="@color/karoo_yellow_fg" />

                <TextView
                    android:fontFamily="relative"
                android:letterSpacing="-0.04"
                    android:id="@+id/start_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/karoo_yellow_fg"
                    android:textSize="44sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:fontFamily="ibm-plex-sans-condensed"
                    android:id="@+id/start_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/start_workout"
                    android:textAllCaps="true"
                    android:textColor="@color/karoo_yellow_fg"
                    android:textSize="24sp"
                    android:textStyle="normal" />

                <!-- CONTINUE: where the workout was ("INTERVAL 4 / 10 · 2:13 IN") -->
                <TextView
                    android:id="@+id/start_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="ibm-plex-sans-condensed"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/karoo_yellow_fg"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
            <!-- Indoors before the ride: a real Karoo, its start button flashing (IndoorStartArt) -->
            <ImageView
                android:id="@+id/start_indoor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:visibility="gone" />

        </FrameLayout>

        <!-- START OVER, under CONTINUE (only when a workout is selected again mid-ride) -->
        <FrameLayout
            android:id="@+id/btn_start_over"
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_tile_tonal"
            android:contentDescription="@string/start_over"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="ibm-plex-sans-condensed"
                android:includeFontPadding="false"
                android:text="@string/start_over"
                android:textAllCaps="true"
                android:textColor="@color/text"
                android:textSize="16sp" />
        </FrameLayout>

        <!-- Outdoor profile with a trainer sending power, before the ride: pick an indoor profile
             (docs/design/indoor-erg/trainer-hint). The kit's warning orange, 24 px. -->
        <LinearLayout
            android:id="@+id/trainer_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_trainer_hint"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="7dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/trainer_hint_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_indoor_trainer" />

            <TextView
                android:id="@+id/trainer_hint_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:text="@string/trainer_hint"
                android:textColor="@color/settings_warn"
                android:textSize="12.8sp" />
        </LinearLayout>

        <!-- Indoors, before the workout starts: the trainer icon and INDOOR SESSION, grey, 24 px
             (the smallest text on the Karoo), above the workout's name -->
        <LinearLayout
            android:id="@+id/indoor_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/indoor_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_indoor_trainer" />

            <TextView
                android:id="@+id/indoor_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/indoor_session"
                android:textAllCaps="true"
                android:textColor="@color/settings_help"
                android:textSize="12.8sp" />
        </LinearLayout>

        <!-- The workout's name and total time, baseline-aligned like the interval row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:fontFamily="ibm-plex-sans-condensed"
                android:id="@+id/ready_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="normal" />

            <TextView
                android:fontFamily="relative"
                android:letterSpacing="-0.04"
                android:id="@+id/ready_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="21sp"
                android:textStyle="normal" />
        </LinearLayout>
        </LinearLayout>

        <!-- Lower part: next interval / countdown and the chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingStart="3dp"
            android:paddingTop="3dp"
            android:paddingEnd="3dp"
            android:paddingBottom="1dp">

        <!-- "Next up" box: ⏮ near the left edge, ⏭ near the right edge, each with an invisible tap
             area covering its end of the box; centred text. While a jump is being chosen, a fill
             grows behind everything (3 steps) and tapping the middle cancels. -->
        <FrameLayout
            android:id="@+id/next_box"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/select_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/bg_select_fill" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/btn_previous"
                    android:layout_width="56dp"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:id="@+id/th_ready_karoo_7"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_btn_pause">

                        <ImageView
                            android:id="@+id/th_ready_karoo_8"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_previous"
                            android:src="@drawable/ic_previous" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/next_mid"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:fontFamily="ibm-plex-sans-condensed"
                        android:id="@+id/next_label"
                        android:textAllCaps="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/next_value"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:autoSizeMaxTextSize="23sp"
                        android:autoSizeMinTextSize="11sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/text"
                android:fontFamily="relative"
                android:letterSpacing="-0.04"
                />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/btn_skip"
                    android:layout_width="56dp"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:id="@+id/skip_bg"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_btn_skip_inverted">

                        <ImageView
                            android:id="@+id/skip_icon"
                            android:tint="@color/bg"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/cd_skip"
                            android:src="@drawable/ic_skip" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Jump countdown (replaces the Next up box). Karoo style: the Karoo's workout purple,
             filling with its darker purple as the seconds run down (countdown_fill); the number
             left, "JUMPING TO" and the step right, spaced like Next up. -->
        <FrameLayout
            android:id="@+id/countdown_box"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/countdown_fill"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                android:progressDrawable="@drawable/progress_countdown_karoo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="relative"
                android:letterSpacing="-0.04"
                    android:includeFontPadding="false"
                    android:textColor="@color/karoo_purple_fg"
                    android:textSize="31sp" />

                <!-- Same text block as Next up: 11sp label, 1dp gap, the step on a 24dp line (up to 20sp),
                     centred in the 48dp box; here aligned right. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/countdown_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:fontFamily="ibm-plex-sans-condensed"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/jumping_to"
                        android:textAllCaps="true"
                        android:textColor="@color/karoo_purple_sub"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/countdown_value"
                        android:layout_width="match_parent"
                        android:layout_height="24dp"
                        android:autoSizeMaxTextSize="23sp"
                        android:autoSizeMinTextSize="11sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:gravity="end|center_vertical"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/karoo_purple_fg"
                android:fontFamily="relative"
                android:letterSpacing="-0.04"
                />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <ImageView
            android:id="@+id/chart"
            android:layout_marginStart="-3dp"
            android:layout_marginEnd="-3dp"
            android:layout_marginBottom="-1dp"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:contentDescription="@string/cd_chart"
            android:scaleType="fitXY" />
        </LinearLayout>

    </LinearLayout>

    <!-- Corner buttons on the outer layer, so they sit right in the corners. No background,
         48dp touch area each. -->
    <FrameLayout
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start">

        <ImageView
            android:id="@+id/th_ready_karoo_9"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_settings"
            android:alpha="0.55"
            android:tint="@color/text" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/btn_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/btn_pause_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/cd_pause"
            android:src="@drawable/ic_pause" />
    </FrameLayout>

    <!-- Heart rate, centred on the same line as the gear and pause icons (40dp row: icons are
         24dp, 8dp from the top, clear of Karoo's swipe-down strip). -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal">

        <!-- The top row as one image (TopRowArt: BigWatts' heart-rate line rules), as on the workout screen -->
        <ImageView
            android:id="@+id/top_img"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="center" />

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <!-- Bottom on the text baseline; the heart itself is about as tall as the digits -->
                <ImageView
                    android:id="@+id/hr_icon"
                    android:layout_width="17dp"
                    android:layout_height="15.5dp"
                    android:layout_marginEnd="5dp"
                    android:baselineAlignBottom="true"
                    android:contentDescription="@string/cd_heart_rate"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_heart" />

                <TextView
                    android:fontFamily="relative"
                android:letterSpacing="-0.04"
                    android:id="@+id/hr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="20sp" />
            </LinearLayout>
    </FrameLayout>

    <!-- Resume button while you've paused the workout: a green half-pill, rounded on the left and
         flat against the screen edge. Replaces the small pause button. -->
    <FrameLayout
        android:id="@+id/btn_resume"
        android:layout_width="64dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_resume_karoo"
        android:visibility="gone">

        <ImageView
            android:id="@+id/th_ready_karoo_11"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:layout_marginStart="3dp"
            android:contentDescription="@string/cd_resume"
            android:src="@drawable/ic_play_filled"
            android:tint="@color/karoo_yellow_fg" />
    </FrameLayout>
</FrameLayout>
