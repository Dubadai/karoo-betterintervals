<?xml version="1.0" encoding="utf-8"?>
<!--
  GENERATED by tools/gen_done_layouts.py. Do not edit by hand.
  Workout done: shown when the last interval ends. DONE takes the workout off (free-ride screen);
  the ride keeps recording.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/done_check"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:maxHeight="84dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_done_check" />

        <TextView
            android:fontFamily="ibm-plex-sans-condensed"
            android:id="@+id/done_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/workout_done"
            android:textAllCaps="true"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="normal" />

        <TextView
            android:fontFamily="ibm-plex-sans-condensed"
            android:id="@+id/done_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/done_tile_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tile_tonal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">

                <TextView
                    android:fontFamily="ibm-plex-sans-condensed"
                    android:id="@+id/done_label_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/time"
                    android:textAllCaps="true"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="normal" />

                <TextView
                    android:fontFamily="sans-serif"
                    android:id="@+id/done_value_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:gravity="end|bottom"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="normal"
                    android:letterSpacing="-0.05"
                    android:textScaleX="0.9" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/done_tile_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tile_tonal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">

                <TextView
                    android:fontFamily="ibm-plex-sans-condensed"
                    android:id="@+id/done_label_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/avg_power"
                    android:textAllCaps="true"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="normal" />

                <TextView
                    android:fontFamily="sans-serif"
                    android:id="@+id/done_value_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:gravity="end|bottom"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="normal"
                    android:letterSpacing="-0.05"
                    android:textScaleX="0.9" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/done_tile_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_tile_tonal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">

                <TextView
                    android:fontFamily="ibm-plex-sans-condensed"
                    android:id="@+id/done_label_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/done_np"
                    android:textAllCaps="true"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="normal" />

                <TextView
                    android:fontFamily="sans-serif"
                    android:id="@+id/done_value_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:gravity="end|bottom"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="normal"
                    android:letterSpacing="-0.05"
                    android:textScaleX="0.9" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/done_tile_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tile_tonal"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">

                <TextView
                    android:fontFamily="ibm-plex-sans-condensed"
                    android:id="@+id/done_label_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/avg_hr"
                    android:textAllCaps="true"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="normal" />

                <TextView
                    android:fontFamily="sans-serif"
                    android:id="@+id/done_value_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:gravity="end|bottom"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="26sp"
                    android:textStyle="normal"
                    android:letterSpacing="-0.05"
                    android:textScaleX="0.9" />
            </FrameLayout>
        </LinearLayout>

        <!-- DONE: the whole box is the button -->
        <FrameLayout
            android:id="@+id/btn_done"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_done_karoo"
            android:contentDescription="@string/done">

            <TextView
                android:id="@+id/th_done_karoo_1"
                android:fontFamily="ibm-plex-sans-condensed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:includeFontPadding="false"
                android:text="@string/done"
                android:textAllCaps="true"
                android:textColor="@color/karoo_yellow_fg"
                android:textSize="26sp"
                android:textStyle="normal" />
        </FrameLayout>

        <!-- The ride keeps recording: a red dot and a short note -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/th_done_karoo_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/dot_recording" />

            <TextView
                android:id="@+id/th_done_karoo_3"
                android:fontFamily="ibm-plex-sans-condensed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/ride_keeps_recording"
                android:textAllCaps="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start">

        <ImageView
            android:id="@+id/done_gear_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_settings"
            android:alpha="0.55"
            android:tint="@color/text" />
    </FrameLayout>
</FrameLayout>
